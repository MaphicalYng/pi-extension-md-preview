{
	"name": "pi-md-preview",
	"version": "0.5.0",
	"description": "Markdown preview extension for Pi and OMP: render Markdown files as polished web pages with an auto-exiting preview server",
	"type": "module",
	"keywords": ["pi-package", "markdown", "preview", "report"],
	"license": "MIT",
	"author": "MaphicalYng",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MaphicalYng/pi-extension-md-preview.git"
	},
	"homepage": "https://github.com/MaphicalYng/pi-extension-md-preview#readme",
	"bugs": {
		"url": "https://github.com/MaphicalYng/pi-extension-md-preview/issues"
	},
	"files": [
		"extensions",
		"README.md",
		"README.zh-CN.md",
		"LICENSE",
		"NOTICE"
	],
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"pi": {
		"extensions": ["./extensions/md-preview/index.ts"]
	},
	"omp": {
		"extensions": ["./extensions/md-preview/index.ts"]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"dependencies": {
		"marked": "^15.0.12"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"mermaid": "^11",
		"typescript": "^5.8.0"
	},
	"scripts": {
		"check": "node scripts/check.mjs",
		"check:i18n": "node scripts/i18n-check.mjs && node scripts/page-i18n-check.mjs",
		"prepublishOnly": "npm run check && npm run check:i18n",
		"demo": "node scripts/demo.mjs",
		"smoke:omp": "node scripts/omp-smoke.mjs",
		"vendor:mermaid": "node scripts/vendor-mermaid.mjs"
	}
}
